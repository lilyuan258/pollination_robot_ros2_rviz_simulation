<?xml version="1.0" encoding="UTF-8"?>
<robot name="only_robot_arm">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="arm">
    <joint name="joint_1"/>
    <joint name="joinit_2"/>
    <joint name="joint_3"/>
    <joint name="joint_4"/>
    <joint name="joint_5"/>
    <joint name="joint_6"/>
  </group>

  <group name="pollination_tip_group">
    <link name="pollination_tip_link"/>
  </group>

  <end_effector name="pollination_tip" parent_link="link_6" group="pollination_tip_group" parent_group="arm"/>

  <group_state name="contracted" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joinit_2" value="2.087"/>
    <joint name="joint_3" value="-2.495"/>
    <joint name="joint_4" value="0.085"/>
    <joint name="joint_5" value="0.458"/>
    <joint name="joint_6" value="0.017"/>
  </group_state>

  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="pollination_tip_link" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="camera_link" reason="Never"/>
</robot>
